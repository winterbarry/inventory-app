<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FreshStock | Dashboard</title>
  <link rel="stylesheet" href="/css/main.css">
</head>

<body>

  <!-- Main Header -->
  <%- include('partials/header') %>

  <main class="dashboard">

    <!-- Dashboard Introduction -->
    <section class="dashboard-intro">
      <h1>DASHBOARD</h1>
      <p>Welcome back! Here's an overview of your grocery inventory.</p>
    </section>

    <!-- Inventory Overview Heading -->
    <section class="inventory-overview-heading">
      <h2>INVENTORY OVERVIEW</h2>
    </section>

    <!-- Inventory Overview Cards -->
    <section class="inventory-overview">

      <div class="overview-cards">

        <div class="overview-card">
          <h3>TOTAL PRODUCTS</h3>
          <p class="overview-number">120</p>
          <span>Products in store</span>
        </div>

        <div class="overview-card">
          <h3>TOTAL CATEGORIES</h3>
          <p class="overview-number"><%= categories.length %></p>
          <span>Active categories</span>
        </div>

        <div class="overview-card">
          <h3>LOW STOCK ITEMS</h3>
          <p class="overview-number">12</p>
          <span>Need attention</span>
        </div>

      </div>
    </section>

    <!-- Grocery Categories Heading -->
    <section class="categories-header">
      <div>
        <h2>GROCERY CATEGORIES</h2>
        <p>Manage and organize your store's products.</p>
      </div>

      <a href="/categories/new" class="btn btn-primary">
        + Add Category
      </a>
    </section>

    <section class="category-grid">

      <% categories.forEach(category => { %>

      <div class="category-card">

        <h3><%= category.name %></h3>

        <p class="category-description">
          <%= category.description %>
        </p>

        <p class="product-count">0 Products</p>

        <div class="category-actions">

          <a href="/categories/<%= category.id %>" class="btn btn-view">
            View Category
          </a>

          <!-- ? -->
          <a href="/categories/<%= category.id %>/edit" class="btn btn-edit">
            Edit
          </a>

          <!-- ? -->
          <form action="/categories/<%= category.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this category?');">

            <button type="submit" class="btn btn-delete">
              Delete
            </button>

          </form>

        </div>

      </div>

      <% }) %>

    </section>

  </main>

  <%- include('partials/footer') %>

</body>

</html>