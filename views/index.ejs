<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FreshStock | Dashboard</title>
  <link rel="stylesheet" href="/css/main.css">
</head>

<body>

  <!-- Main Header -->
  <%- include('partials/header') %>

  <main class="dashboard">

    <!-- Dashboard Introduction -->
    <section class="dashboard-intro">
      <h1>DASHBOARD</h1>
      <p>Welcome back! Here's an overview of your grocery inventory.</p>
    </section>

    <!-- Inventory Overview Heading -->
    <section class="inventory-overview-heading">
      <h2>INVENTORY OVERVIEW</h2>
    </section>

    <!-- Inventory Overview Cards -->
    <section class="inventory-overview">

      <div class="overview-cards">

        <div class="overview-card">
          <h3>TOTAL PRODUCTS</h3>
          <p class="overview-number">120</p>
          <span>Products in store</span>
        </div>

        <div class="overview-card">
          <h3>TOTAL CATEGORIES</h3>
          <p class="overview-number">8</p>
          <span>Active categories</span>
        </div>

        <div class="overview-card">
          <h3>LOW STOCK ITEMS</h3>
          <p class="overview-number">12</p>
          <span>Need attention</span>
        </div>

      </div>
    </section>

    <!-- Grocery Categories Heading -->
    <section class="categories-header">
      <div>
        <h2>GROCERY CATEGORIES</h2>
        <p>Manage and organize your store's products.</p>
      </div>

      <a href="/categories/new" class="btn btn-primary">
        + Add Category
      </a>
    </section>

    <!-- Category Cards -->
    <section class="category-grid">

      <div class="category-card">
        <h3>FRUITS & VEGETABLES</h3>
        <p class="category-description">
          Fresh fruits and vegetables
        </p>
        <p class="product-count">25 Products</p>

        <a href="/categories/1" class="btn btn-view">
          View Category
        </a>

        <div class="category-actions">
          <a href="/categories/1/edit" class="btn btn-edit">Edit</a>
          <form action="/categories/1/delete" method="POST">
            <button type="submit" class="btn btn-delete">Delete</button>
          </form>
        </div>
      </div>

      <div class="category-card">
        <h3>DAIRY PRODUCTS</h3>
        <p class="category-description">
          Milk, cheese and other dairy
        </p>
        <p class="product-count">18 Products</p>

        <a href="/categories/2" class="btn btn-view">
          View Category
        </a>

        <div class="category-actions">
          <a href="/categories/2/edit" class="btn btn-edit">Edit</a>
          <form action="/categories/2/delete" method="POST">
            <button type="submit" class="btn btn-delete">Delete</button>
          </form>
        </div>
      </div>

      <div class="category-card">
        <h3>MEAT & POULTRY</h3>
        <p class="category-description">
          Fresh meat and poultry
        </p>
        <p class="product-count">15 Products</p>

        <a href="/categories/3" class="btn btn-view">
          View Category
        </a>

        <div class="category-actions">
          <a href="/categories/3/edit" class="btn btn-edit">Edit</a>
          <form action="/categories/3/delete" method="POST">
            <button type="submit" class="btn btn-delete">Delete</button>
          </form>
        </div>
      </div>

      <div class="category-card">
        <h3>BEVERAGES</h3>
        <p class="category-description">
          Drinks and refreshments
        </p>
        <p class="product-count">20 Products</p>

        <a href="/categories/4" class="btn btn-view">
          View Category
        </a>

        <div class="category-actions">
          <a href="/categories/4/edit" class="btn btn-edit">Edit</a>
          <form action="/categories/4/delete" method="POST">
            <button type="submit" class="btn btn-delete">Delete</button>
          </form>
        </div>
      </div>

      <div class="category-card">
        <h3>BAKERY</h3>
        <p class="category-description">
          Bread, pastries and snacks
        </p>
        <p class="product-count">12 Products</p>

        <a href="/categories/5" class="btn btn-view">
          View Category
        </a>

        <div class="category-actions">
          <a href="/categories/5/edit" class="btn btn-edit">Edit</a>
          <form action="/categories/5/delete" method="POST">
            <button type="submit" class="btn btn-delete">Delete</button>
          </form>
        </div>
      </div>

      <div class="category-card">
        <h3>CANNED FOODS</h3>
        <p class="category-description">
          Canned and preserved foods
        </p>
        <p class="product-count">10 Products</p>

        <a href="/categories/6" class="btn btn-view">
          View Category
        </a>

        <div class="category-actions">
          <a href="/categories/6/edit" class="btn btn-edit">Edit</a>
          <form action="/categories/6/delete" method="POST">
            <button type="submit" class="btn btn-delete">Delete</button>
          </form>
        </div>
      </div>

    </section>

  </main>

  <%- include('partials/footer') %>

</body>

</html>