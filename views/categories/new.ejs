<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FreshStock | Add Category</title>
  <link rel="stylesheet" href="/css/main.css">
</head>

<body>

  <!-- Main Header -->
  <%- include('../partials/header') %>

  <!-- Main Content -->
  <main class="main-content">

    <section class="category-form-section">

      <!-- Form Header -->
      <div class="form-header">
        <h2>ADD NEW CATEGORY</h2>
        <p>Enter the details below to create a new product category.</p>
      </div>

      <!-- Category Form -->
      <form action="/categories" method="POST" class="category-form">

        <div class="form-group">
          <label for="name">Category Name</label>
          <input type="text" id="name" name="name" placeholder="Enter category name" required>
        </div>

        <div class="form-group">
          <label for="description">Category Description</label>
          <textarea id="description" name="description" rows="4" placeholder="Enter category description"></textarea>
        </div>

        <!-- Form Buttons -->
        <div class="form-actions">
          <a href="/categories" class="cancel-btn">Cancel</a>
          <button type="submit" class="submit-btn">Add Category</button>
        </div>

      </form>

    </section>

  </main>

  <!-- Main Footer -->
  <%- include('../partials/footer') %>

</body>

</html>